# Copy this file to .env for local development.
# Keep real credentials in .env only; never commit that file.
#
# The React/Vite UI reads data through the server-side API. Keep credentials
# here only; never rename secrets with a VITE_ prefix because Vite exposes
# VITE_* values to the browser.

API_PORT=8787

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_WAREHOUSE=FREEPORT_LEARNING_WH
SNOWFLAKE_DATABASE=FREEPORT_MINING_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_PRODUCTION_TABLE=PRODUCTION
SNOWFLAKE_EQUIPMENT_TABLE=EQUIPMENT
SNOWFLAKE_SHIPMENT_TABLE=SHIPMENT
SNOWFLAKE_PRIVATE_KEY_PATH=
