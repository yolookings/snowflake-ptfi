# Copy this file to .env for local development.
# Keep real credentials in .env only; never commit that file.
#
# The current React/Vite prototype uses local demo data. These Snowflake
# variables are reserved for a future server-side adapter. Do not rename
# secrets with a VITE_ prefix: Vite exposes VITE_* values to the browser.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=MINE_ANALYTICS_WH
SNOWFLAKE_DATABASE=PTFI_MINE_ANALYTICS
SNOWFLAKE_SCHEMA=OPERATIONS
SNOWFLAKE_PRIVATE_KEY_PATH=
